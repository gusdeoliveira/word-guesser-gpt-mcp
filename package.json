{
  "name": "word-guesser-gpt-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -k -n WEB,SERVER -c cyan,green \"vite --config web/vite.config.ts\" \"tsx watch server/src/index.ts\"",
    "dev:web": "vite --config web/vite.config.ts",
    "dev:server": "tsx watch server/src/index.ts",
    "build": "npm run build:web && npm run typecheck",
    "build:web": "vite build --config web/vite.config.ts",
    "start": "tsx server/src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "1.7.4",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@openai/apps-sdk-ui": "0.2.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "concurrently": "10.0.3",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "vite": "8.1.5",
    "vite-plugin-singlefile": "2.3.3",
    "vitest": "4.1.10"
  }
}
